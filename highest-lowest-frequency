class Solution:
    def getHighestLowestFreq(self, arr):
        freq = {}

        for num in arr:
            freq[num] = freq.get(num, 0) + 1

        max_freq = 0
        min_freq = float('inf')
        max_elem = None
        min_elem = None

        for key, value in freq.items():
            if value > max_freq:
                max_freq = value
                max_elem = key
            if value < min_freq:
                min_freq = value
                min_elem = key

        return max_elem, min_elem
